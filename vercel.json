{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "quizground",
  "installCommand": "[ -d \"client\" ] && (cd client && npm install) || npm install",
  "buildCommand": "[ -d \"client\" ] && (cd client && npm run build) || npm run build",
  "outputDirectory": "client/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
